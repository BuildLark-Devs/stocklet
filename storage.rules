rules_version = '2';

// Cloud Storage rules for Stocklet.
//
// Paths the app uses (lib/datos_app.dart):
//   usuarios/{uid}/foto_perfil                  -> profile photo
//   negocios/{negocioId}/logo/imagen            -> business logo
//   negocios/{negocioId}/catalogos/{archivo}    -> PDF catalogues
//
// Business membership is read from Firestore, which is where it lives.

service firebase.storage {
  match /b/{bucket}/o {

    function autenticado() {
      return request.auth != null;
    }

    function miFicha() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }

    function tengoFicha() {
      return autenticado() &&
             firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid));
    }

    function esMiembro(negocioId) {
      return tengoFicha() && miFicha().get('negocioId', '') == negocioId;
    }

    function esDuenoOSocio(negocioId) {
      return esMiembro(negocioId) && miFicha().get('rol', 'empleado') in ['dueno', 'socio'];
    }

    // Only the owner changes the logo: panel_usuario.dart gates that action on
    // `esDueno` (negocio.duenoUid == uid), not on owner-or-partner.
    function esDuenoDelNegocio(negocioId) {
      return autenticado() &&
             firestore.exists(/databases/(default)/documents/negocios/$(negocioId)) &&
             firestore.get(/databases/(default)/documents/negocios/$(negocioId)).data
               .get('duenoUid', '') == request.auth.uid;
    }

    function esImagen() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 5 * 1024 * 1024;
    }

    function esPdf() {
      return request.resource.contentType == 'application/pdf' &&
             request.resource.size < 20 * 1024 * 1024;
    }

    // Profile photo: managed by its owner. Read by the members of the business
    // (the members screen shows the photos).
    match /usuarios/{uid}/{archivo=**} {
      allow read: if autenticado();
      allow write: if autenticado() && request.auth.uid == uid && esImagen();
      allow delete: if autenticado() && request.auth.uid == uid;
    }

    // Business logo: every member sees it, only the owner changes it.
    match /negocios/{negocioId}/logo/{archivo=**} {
      allow read: if esMiembro(negocioId);
      allow write: if esDuenoDelNegocio(negocioId) && esImagen();
      allow delete: if esDuenoDelNegocio(negocioId);
    }

    // PDF catalogues: every member sees them, owner and partner upload them.
    match /negocios/{negocioId}/catalogos/{archivo=**} {
      allow read: if esMiembro(negocioId);
      allow write: if esDuenoOSocio(negocioId) && esPdf();
      allow delete: if esDuenoOSocio(negocioId);
    }

    // Everything else, closed.
    match /{rutaCualquiera=**} {
      allow read, write: if false;
    }
  }
}
