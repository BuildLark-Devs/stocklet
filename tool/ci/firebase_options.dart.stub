// Filler copy of lib/firebase_options.dart for CI.
//
// The real file is generated by `flutterfire configure` and is not versioned.
// CI needs no working credentials: it only needs the file to exist, because
// lib/main.dart imports it and without it `flutter analyze` and
// `flutter build` fail with "Target of URI doesn't exist". Nothing in CI
// connects to Firebase.
//
// The extension is .stub on purpose, so the analyzer ignores it. The workflow
// copies it into place:
//   cp tool/ci/firebase_options.dart.stub lib/firebase_options.dart
//
// If a new field is ever added to the real file, add it here too or CI will
// stop compiling.

// ignore_for_file: type=lint
import 'package:firebase_core/firebase_core.dart' show FirebaseOptions;
import 'package:flutter/foundation.dart'
    show defaultTargetPlatform, kIsWeb, TargetPlatform;

class DefaultFirebaseOptions {
  static FirebaseOptions get currentPlatform {
    if (kIsWeb) {
      return web;
    }
    switch (defaultTargetPlatform) {
      case TargetPlatform.android:
        return android;
      case TargetPlatform.iOS:
        return ios;
      default:
        throw UnsupportedError(
          'This is the CI filler configuration and cannot run the app. '
          'Generate the real one with `flutterfire configure`.',
        );
    }
  }

  static const FirebaseOptions web = FirebaseOptions(
    apiKey: 'ci-no-credentials',
    appId: '1:000000000000:web:0000000000000000000000',
    messagingSenderId: '000000000000',
    projectId: 'demo-stocklet',
    authDomain: 'demo-stocklet.firebaseapp.com',
    storageBucket: 'demo-stocklet.firebasestorage.app',
  );

  static const FirebaseOptions android = FirebaseOptions(
    apiKey: 'ci-no-credentials',
    appId: '1:000000000000:android:0000000000000000000000',
    messagingSenderId: '000000000000',
    projectId: 'demo-stocklet',
    storageBucket: 'demo-stocklet.firebasestorage.app',
  );

  static const FirebaseOptions ios = FirebaseOptions(
    apiKey: 'ci-no-credentials',
    appId: '1:000000000000:ios:0000000000000000000000',
    messagingSenderId: '000000000000',
    projectId: 'demo-stocklet',
    storageBucket: 'demo-stocklet.firebasestorage.app',
    iosBundleId: 'com.buildlark.stocklet',
  );
}
