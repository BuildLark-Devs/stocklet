rules_version = '2';

// Firestore security rules for Stocklet.
//
// Guiding principle (constitution, Principle II): the UI hides buttons, but
// this file is what actually decides. Every piece of business data lives under
// negocios/{negocioId} and is only touched by someone who belongs to that
// business, with the permission their role grants.
//
// Data model:
//   usuarios/{uid}          -> { negocioId, rol, nombre, celular, fotoUrl, ... }
//   negocios/{negocioId}    -> { nombre, pais, moneda, idioma, duenoUid, ... }
//   negocios/{negocioId}/{insumos|productos|ventas|gastos|pedidos|
//                          cotizaciones|recetas|catalogos}/{docId}
//   invitaciones/{codigo}   -> { negocioId, rol, estado, creadoPor, usadaPor }
//
// Roles: 'dueno' (owner) | 'socio' (partner) | 'empleado' (employee).

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------

    function autenticado() {
      return request.auth != null;
    }

    function esElMismo(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    function rutaMiUsuario() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    // I have a user record (and therefore can belong to a business).
    function tengoFicha() {
      return autenticado() && exists(rutaMiUsuario());
    }

    function miFicha() {
      return get(rutaMiUsuario()).data;
    }

    function miNegocio() {
      return miFicha().get('negocioId', '');
    }

    function miRol() {
      return miFicha().get('rol', 'empleado');
    }

    // A usable negocioId: it exists and is not an empty string. Without this
    // guard, a user with no negocioId ('' by default) would be a "member" of any
    // document whose negocioId was also empty, and the paths built further down
    // would carry an empty segment (evaluation error).
    function negocioValido(negocioId) {
      return negocioId is string && negocioId != '';
    }

    function esMiembro(negocioId) {
      return tengoFicha() && negocioValido(negocioId) && miNegocio() == negocioId;
    }

    // Owner by role, or by having created the business (mirrors DatosApp.esDueno).
    function esDueno(negocioId) {
      return esMiembro(negocioId) && (
        miRol() == 'dueno' ||
        (exists(/databases/$(database)/documents/negocios/$(negocioId)) &&
         get(/databases/$(database)/documents/negocios/$(negocioId)).data
           .get('duenoUid', '') == request.auth.uid)
      );
    }

    // Owner or partner: manages the catalogue, edits finances and may delete.
    function esDuenoOSocio(negocioId) {
      return esMiembro(negocioId) && (miRol() in ['dueno', 'socio'] || esDueno(negocioId));
    }

    // The listed fields are unchanged from what was already there.
    function noTocaCampos(campos) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(campos);
    }

    // ------------------------------------------------------------------
    // usuarios/{uid}
    //
    // This is the sensitive piece: negocioId and rol live here, so anyone able
    // to write them at will could enter any business as its owner. That is why
    // only two paths may set them: creating a business of your own, or redeeming
    // an invitation already marked in your name.
    // ------------------------------------------------------------------

    match /usuarios/{uid} {

      // My own record, always. Someone else's only if we share a business
      // (needed by the members screen).
      allow get: if esElMismo(uid) ||
                    (tengoFicha() && resource.data.get('negocioId', '') == miNegocio());

      // Listing: only the query filtered by my business.
      allow list: if tengoFicha() && resource.data.get('negocioId', '') == miNegocio();

      // --- Writing to my own record ---

      // Personal and session data, without touching membership or role.
      function soloDatosPersonales() {
        return resource != null && noTocaCampos(['negocioId', 'rol', 'invitacionCodigo']);
      }

      // I become the owner of a business I have just created.
      function meHagoDuenoDeMiNegocio() {
        let negId = request.resource.data.get('negocioId', '');
        return request.resource.data.get('rol', '') == 'dueno' &&
               negId != '' &&
               exists(/databases/$(database)/documents/negocios/$(negId)) &&
               get(/databases/$(database)/documents/negocios/$(negId)).data
                 .get('duenoUid', '') == request.auth.uid;
      }

      // I join a business with a code I already claimed (state 'usada' in my
      // name). The invitation rules: business and role must match it.
      // Note: the path is built inside the short circuit, never in a `let`.
      // With an empty code the path carries an empty segment and the rule blows
      // up before it can be discarded.
      function meUnoConInvitacion() {
        let codigo = request.resource.data.get('invitacionCodigo', '');
        return codigo != '' &&
               exists(/databases/$(database)/documents/invitaciones/$(codigo)) &&
               get(/databases/$(database)/documents/invitaciones/$(codigo)).data
                 .get('usadaPor', '') == request.auth.uid &&
               get(/databases/$(database)/documents/invitaciones/$(codigo)).data
                 .get('negocioId', '') == request.resource.data.get('negocioId', '') &&
               get(/databases/$(database)/documents/invitaciones/$(codigo)).data
                 .get('rol', '') == request.resource.data.get('rol', '') &&
               request.resource.data.get('rol', '') in ['socio', 'empleado'];
      }

      allow create: if esElMismo(uid) && (
                       !('negocioId' in request.resource.data) ||
                       meHagoDuenoDeMiNegocio() ||
                       meUnoConInvitacion()
                     );

      allow update: if esElMismo(uid) && (
                       soloDatosPersonales() ||
                       meHagoDuenoDeMiNegocio() ||
                       meUnoConInvitacion()
                     );

      // --- Writing to another member's record ---
      // The owner changes their people's role, but cannot manufacture more
      // owners nor move anyone between businesses.
      allow update: if resource != null &&
                       esDueno(resource.data.get('negocioId', '')) &&
                       request.resource.data.get('negocioId', '') == resource.data.get('negocioId', '') &&
                       request.resource.data.get('rol', '') in ['socio', 'empleado'];

      // Me leaving, or the owner removing a member from their business.
      allow delete: if esElMismo(uid) ||
                       (resource != null && esDueno(resource.data.get('negocioId', '')));
    }

    // ------------------------------------------------------------------
    // negocios/{negocioId}
    // ------------------------------------------------------------------

    match /negocios/{negocioId} {

      allow get, list: if esMiembro(negocioId);

      // Creating your own business: the creator becomes the owner, no exception.
      allow create: if autenticado() &&
                       request.resource.data.get('duenoUid', '') == request.auth.uid;

      // Business settings (currency, costing, appearance): owner or partner.
      // The owner cannot be reassigned from the client.
      allow update: if resource != null && esDuenoOSocio(negocioId) &&
                       request.resource.data.get('duenoUid', '') == resource.data.get('duenoUid', '');

      // Deleting the business is done by the eliminarCuenta Cloud Function with
      // admin privileges; never from the client.
      allow delete: if false;

      // ----------------------------------------------------------------
      // Business subcollections
      // ----------------------------------------------------------------

      // Catalogue and commercial documents: only owner or partner touch them.
      match /productos/{docId} {
        allow read: if esMiembro(negocioId);
        allow write: if esDuenoOSocio(negocioId);
      }

      match /recetas/{docId} {
        allow read: if esMiembro(negocioId);
        allow write: if esDuenoOSocio(negocioId);
      }

      // Quotes: any member quotes for a customer, and may correct the quote
      // while assembling it (the edit screen does not distinguish role).
      // Deleting them is still owner and partner only.
      // Note: the model does not store who created it, so the rules cannot
      // limit editing to the author; if that is ever needed, the field has to
      // be added in models/cotizacion.dart first.
      match /cotizaciones/{docId} {
        allow read, create, update: if esMiembro(negocioId);
        allow delete: if esDuenoOSocio(negocioId);
      }

      // Catalogues: the employee reads them, but does not upload or delete them.
      match /catalogos/{docId} {
        allow read: if esMiembro(negocioId);
        allow write: if esDuenoOSocio(negocioId);
      }

      // Supplies: owner and partner rule. The employee may NOT edit a supply,
      // but does have to be able to deduct stock when selling or dispatching an
      // order. The app saves the whole document in that flow, so what is
      // verified is that the only field changing value is stockActual.
      match /insumos/{docId} {
        allow read: if esMiembro(negocioId);
        allow create, delete: if esDuenoOSocio(negocioId);
        allow update: if esDuenoOSocio(negocioId) ||
                         (esMiembro(negocioId) &&
                          request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['stockActual']));
      }

      // Movements: any member records them; correcting or deleting history is
      // left to owner and partner.
      match /ventas/{docId} {
        allow read, create: if esMiembro(negocioId);
        allow update, delete: if esDuenoOSocio(negocioId);
      }

      match /gastos/{docId} {
        allow read, create: if esMiembro(negocioId);
        allow update, delete: if esDuenoOSocio(negocioId);
      }

      // Orders: an employee creates them and advances their state; not delete.
      match /pedidos/{docId} {
        allow read, create, update: if esMiembro(negocioId);
        allow delete: if esDuenoOSocio(negocioId);
      }

      // Any future subcollection stays closed until a deliberate rule of its
      // own is written for it.
      match /{otraColeccion}/{docId} {
        allow read, write: if false;
      }
    }

    // ------------------------------------------------------------------
    // invitaciones/{codigo}
    //
    // The 6-character code is the credential. Whoever holds it can read it to
    // redeem it; nobody can list another business's codes.
    // ------------------------------------------------------------------

    match /invitaciones/{codigo} {

      // Reading a single code: needed to redeem it before being a member.
      allow get: if autenticado();

      // Listing: only the owner, and only their own business's codes.
      allow list: if tengoFicha() &&
                     resource.data.get('negocioId', '') == miNegocio() &&
                     esDueno(miNegocio());

      // Creating: the owner invites to their business, never another, never as owner.
      allow create: if esDueno(request.resource.data.get('negocioId', '')) &&
                       request.resource.data.get('negocioId', '') == miNegocio() &&
                       request.resource.data.get('rol', '') in ['socio', 'empleado'] &&
                       request.resource.data.get('estado', '') == 'pendiente' &&
                       request.resource.data.get('creadoPor', '') == request.auth.uid &&
                       request.resource.data.get('usadaPor', '') == '';

      // Redeeming: pendiente -> usada, in my name, altering nothing else.
      // (Or the owner, who may correct their own invitation.)
      allow update: if resource != null && (
                       (autenticado() &&
                        resource.data.get('estado', '') == 'pendiente' &&
                        request.resource.data.get('estado', '') == 'usada' &&
                        request.resource.data.get('usadaPor', '') == request.auth.uid &&
                        noTocaCampos(['negocioId', 'rol', 'creadoPor'])) ||
                       esDueno(resource.data.get('negocioId', ''))
                     );

      allow delete: if resource != null && esDueno(resource.data.get('negocioId', ''));
    }

    // ------------------------------------------------------------------
    // Everything else: closed. If a new collection appears, let it fail loudly
    // in development rather than sit open in production.
    // ------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
